# ==========================================
# .dockerignore — frontend context (frontend/)
# ==========================================

# Version control
.git
.gitignore

# Dependencies & build output
node_modules
.next
out
build

# Test / coverage
coverage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env & secrets
.env
.env.*
!.env.example

# Typescript build info
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Docker files (don't bake into image)
Dockerfile
.dockerignore
